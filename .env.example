# --- MongoDB Atlas ---
# Chaîne de connexion du cluster. Obligatoire : le serveur refuse de démarrer sans.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mpg-companion?retryWrites=true&w=majority

# --- SportMonks (données football) ---
# Token API depuis https://my.sportmonks.com. Facultatif : sans lui les routes
# football répondent 503, le reste de l'application fonctionne normalement.
SPORTMONKS_API_TOKEN=
